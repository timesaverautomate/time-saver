# Configure estes valores APENAS no gestor de segredos do alojamento.
# Nunca colocar valores reais neste ficheiro, no GitHub ou no frontend.
PUBLIC_ORIGIN=https://timesaverautomate.com
MAIL_ENABLED=false
LEGAL_READY=false
RESEND_API_KEY=
# Configurar apenas depois de verificar o domínio no Resend.
MAIL_FROM=Time Saver <pedidos@timesaverautomate.com>
MAIL_TO=timesaverautomate@gmail.com
SECURITY_HMAC_KEY=
# Ativar só depois de o domínio funcionar exclusivamente com HTTPS.
HSTS_ENABLED=false

# Na instalação como backend do GitHub Pages, servir apenas a API.
API_ONLY=true
