{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time-saver-edge",
  "main": "src/site-proxy.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": {
  "enabled": true,
  "logs": {
    "enabled": true,
    "invocation_logs": true
  }
}
  },
  "vars": {
    "FORM_ENABLED": "false",
    "HSTS_ENABLED": "true",
    "SEARCH_INDEXING_ENABLED": "false",
    "TIME_SAVER_REPOSITORY_ID": "1452563434"
  },
  "ratelimits": [
    {
      "name": "FORM_IP_RATE",
      "namespace_id": "1452563434",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "FORM_EDGE_RATE",
      "namespace_id": "1452563435",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "FORM_TOKEN_RATE",
      "namespace_id": "1452563436",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
